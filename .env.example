# このファイルを .env としてコピーし、実際の値を入力してください。
# .env は .gitignore 済みでコミットされません。

# 接続先サーバー (jp / en / cn)。日本版アカウントなら jp のままでOK。
MAJSOUL_SERVER=jp

# --- 日本版(Yostarアカウント)向け ---
# ブラウザで https://game.mahjongsoul.com/ にログインした状態で、
# F12開発者ツール → Application(ストレージ) → Local Storage → 該当サイト から
# 以下3つのキーの値をそれぞれコピーする。
MAJSOUL_YOSTAR_TOKEN=
MAJSOUL_YOSTAR_UID=
MAJSOUL_DEVICE_ID=

# --- CN版アカウント向け(参考: emailLoginが使える場合のみ) ---
MAJSOUL_EMAIL=
MAJSOUL_PASSWORD=

# 牌譜/DBの保存先ディレクトリ(相対パス可)
MAHJONG_ANALYZER_DATA_DIR=data

# --- 評価軸(review/score)向け ---
# 牌譜内でのあなた自身のaccount_id(players.account_id)。ログイン用のUIDとは別物。
# `python -m mahjong_analyzer parse` 実行後にDBの players テーブルを見て、
# 自分の名前に対応するaccount_idを確認する。
MY_ACCOUNT_ID=

# Mortal(押し引き/鳴き/リーチ判断のAI比較評価に使う)のネイティブビルド成果物。
# 未セットアップの場合は空のままでよい(reviewコマンド実行時にエラーメッセージが出る)。
MORTAL_BINARY_PATH=
MORTAL_MODEL_PATH=
